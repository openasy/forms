  "helpdesk": {
    "version": "0.1.0",
    "operations": {
      "POST /api/v1/public/tickets": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicTicket"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PublicTicket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The same external_id from the same source: the ticket it opened before.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTicketCreated"
                }
              }
            }
          },
          "201": {
            "description": "Opened. HTML forms get a thank-you page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTicketCreated"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "Taken and dropped: the hidden website field was filled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTicketCreated"
                }
              }
            }
          },
          "303": {
            "description": "An HTML form with redirect: to that address."
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "components": {
      "schemas": {
        "PublicTicket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "description": "The source id from the settings file. With a key it may be left out: the key says which source it is."
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "The customer's address; replies go to it, and CRM is asked about it. Required for forms."
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "subject": {
              "type": "string",
              "maxLength": 300
            },
            "message": {
              "type": "string",
              "maxLength": 50000,
              "description": "What the customer wrote. Required for forms without a transcript."
            },
            "form": {
              "type": "string",
              "maxLength": 64,
              "description": "Which form, for routing rules with match.form."
            },
            "fields": {
              "type": "object",
              "maxProperties": 50,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "The form's other answers, shown with the message."
            },
            "language": {
              "type": "string",
              "maxLength": 10
            },
            "external_id": {
              "type": "string",
              "maxLength": 200,
              "description": "What Forms or Live Chat calls this request: the same id from the same source opens one ticket."
            },
            "transcript": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "agent"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 10000
                  }
                },
                "required": [
                  "from",
                  "text"
                ]
              },
              "description": "A chat's lines. Agents' lines need the source's key; with one, the first-reply clock is met."
            },
            "website": {
              "type": "string",
              "description": "Leave empty: a hidden field that only bots fill."
            },
            "redirect": {
              "type": "string",
              "format": "uri",
              "description": "For HTML forms: where to send the browser after, on one of the source's origins; ?ticket=<number> is added."
            }
          }
        },
        "PublicTicketCreated": {
          "type": "object",
          "properties": {
            "ticket": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "status": {
                      "$ref": "#/components/schemas/TicketStatus"
                    }
                  },
                  "required": [
                    "number",
                    "reference",
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "ticket",
            "created"
          ],
          "additionalProperties": false
        },
        "TicketStatus": {
          "type": "string",
          "enum": [
            "open",
            "waiting",
            "solved",
            "closed"
          ]
        },
        "Problem": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "type": "integer"
            },
            "code": {
              "type": "string",
              "enum": [
                "invalid-token",
                "invalid-json",
                "invalid-body",
                "forbidden-origin",
                "not-found",
                "conflict",
                "rate-limited",
                "payload-too-large",
                "unavailable",
                "internal-error",
                "unauthenticated",
                "invalid-credentials",
                "mfa-required",
                "mfa-setup-required",
                "forbidden",
                "cross-site"
              ],
              "description": "Stable; match on this."
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code"
          ],
          "additionalProperties": true
        }
      },
      "responses": {
        "Problem": {
          "description": "An error, as RFC 9457 Problem Details.",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/Problem"
              }
            }
          }
        }
      }
    }
  }
}
